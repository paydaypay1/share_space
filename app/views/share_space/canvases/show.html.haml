- content_for :head do
  %meta{ name: "csrf-token", content: form_authenticity_token }
.level.editor-heading
  .level-left
    %div
      %h1.title.is-4= @canvas.name
      %p.subtitle.is-6= "#{@canvas.width} × #{@canvas.height} px"
  .level-right
    = link_to "All canvases", canvases_path, class: "button is-light"
    .select.is-small
      %select#export-format{ aria: { label: "Export format" } }
        %option{ value: "svg" } SVG
        %option{ value: "png" } PNG
        %option{ value: "jpeg" } JPEG
        %option{ value: "webp" } WebP
        %option{ value: "pdf" } PDF
    %button#export-canvas.button.is-link.is-light{ type: "button" } Export
    %span#cursor-position.tag.is-light X 0 · Y 0
.columns.editor-layout
  .column.is-narrow.tool-pane
    .box
      %h2.title.is-6 Tool
      .buttons.are-small.is-flex-direction-column.is-align-items-stretch
        %button.button.is-primary{ type: "button", data: { draw: "select" } } Select / move
      %details.tool-group{ open: true }
        %summary 2D shapes
        .buttons.are-small.is-flex-direction-column.is-align-items-stretch
          %button.button{ type: "button", data: { draw: "rectangle" } } Rectangle
          %button.button{ type: "button", data: { draw: "ellipse" } } Ellipse
          %button.button{ type: "button", data: { draw: "polygon" } } Polygon
          .field
            %label.label.is-size-7{ for: "polygon-sides" } Polygon sides
            .control= number_field_tag :polygon_sides, 5, min: 3, max: 64, class: "input is-small", id: "polygon-sides"
          %button.button{ type: "button", data: { draw: "line" } } Straight line
          %button.button{ type: "button", data: { draw: "bezier_line" } } Bezier curve
          %button.button{ type: "button", data: { draw: "freeform_line" } } Free form line
      %details.tool-group
        %summary 3D shapes
        .buttons.are-small.is-flex-direction-column.is-align-items-stretch
          %button.button{ type: "button", data: { draw: "cube" } } Cube
          %button.button{ type: "button", data: { draw: "sphere" } } Sphere
          %button.button{ type: "button", data: { draw: "cylinder" } } Cylinder
      .box.is-shadowless.p-2
        %h3.title.is-7 Masks
        %button#mask-tool.button.is-small.is-fullwidth{ type: "button", data: { draw: "mask" } } Draw rectangular mask
      .box.is-shadowless.p-2
        %h3.title.is-7 FX
        .field
          %label.label.is-size-7{ for: "fx-symmetry" } Reflection
          .control
            .select.is-small.is-fullwidth
              %select#fx-symmetry
                %option{ value: "none" } None
                %option{ value: "linear" } Linear
                %option{ value: "radial" } Radial
        .field
          %label.label.is-size-7{ for: "fx-count" } Lines / copies
          .control= number_field_tag :fx_count, 2, min: 2, max: 24, class: "input is-small", id: "fx-count"
        .field
          %label.label.is-size-7{ for: "fx-rotate" } Rotate (degrees)
          .control= number_field_tag :fx_rotate, 0, class: "input is-small", id: "fx-rotate", step: 1
        .field
          %label.label.is-size-7{ for: "fx-skew" } Skew (degrees)
          .control= number_field_tag :fx_skew, 0, class: "input is-small", id: "fx-skew", step: 1
        .field
          %label.checkbox.is-size-7
            = check_box_tag :fx_shadow, "1", false, id: "fx-shadow"
            Drop shadow
        %button#apply-fx.button.is-small.is-link.is-light.is-fullwidth{ type: "button" } Apply FX to selection
      .buttons.are-small.mt-3
        %button#undo.button{ type: "button", disabled: true } Undo
        %button#redo.button{ type: "button", disabled: true } Redo
      %p.help Drag shapes to move them. Drag a line's points to reshape it.
  .column.canvas-column
    .canvas-scroll
      %svg#canvas-editor{ xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 #{@canvas.width} #{@canvas.height}", width: @canvas.width, height: @canvas.height,
        style: "background: #{@canvas.background_color}", data: { canvas_width: @canvas.width, canvas_height: @canvas.height,
          create_url: canvas_elements_path(@canvas), update_url: canvas_elements_path(@canvas, id: "ELEMENT_ID"),
          csrf: form_authenticity_token, tool: "select", canvas_id: @canvas.id } }
        - @elements.each do |element|
          - next unless element.visible
          - attrs = { "data-id" => element.id, "data-type" => element.type.demodulize.downcase,
            "data-x" => element.x.to_f, "data-y" => element.y.to_f, "data-width" => element.width.to_f,
            "data-height" => element.height.to_f, "data-fill" => element.fill_color || "#48c78e",
            "data-stroke" => element.stroke_color || "#257953", "data-stroke-width" => element.stroke_width.to_f,
            "data-opacity" => element.opacity.to_f, "data-locked" => element.locked,
            "data-points" => element.points.to_json, "data-name" => element.name,
            "data-options" => (element.options || {}).to_json }
          - if %w[Line BezierLine FreeformLine Polygon].include?(element.type.demodulize)
            - points = (element.points || []).map { |point| point.is_a?(Array) ? point.join(",") : point }.join(" ")
            %polyline{ **attrs, points: points, fill: (element.type.demodulize == "Polygon" ? (element.fill_color || "#48c78e") : "none"), stroke: element.stroke_color || "#257953", "stroke-width" => element.stroke_width || 2 }
          - elsif element.is_a?(Ellipse)
            %ellipse{ **attrs, cx: element.x.to_f + element.width.to_f / 2, cy: element.y.to_f + element.height.to_f / 2,
              rx: element.width.to_f / 2, ry: element.height.to_f / 2, fill: element.fill_color || "#48c78e",
              stroke: element.stroke_color || "#257953", "stroke-width" => element.stroke_width || 2, opacity: element.opacity }
          - elsif %w[Cube Sphere Cylinder].include?(element.type.demodulize)
            %rect{ **attrs, x: element.x, y: element.y, width: element.width, height: element.height, rx: (element.type.demodulize == "Sphere" ? "50%" : 0), fill: element.fill_color || "#48c78e", stroke: element.stroke_color || "#257953", "stroke-width" => element.stroke_width || 2, opacity: element.opacity, "data-options" => (element.options || {}).to_json }
          - else
            %rect{ **attrs, x: element.x, y: element.y, width: element.width, height: element.height,
              fill: element.fill_color || "#48c78e", stroke: element.stroke_color || "#257953",
              "stroke-width" => element.stroke_width || 2, opacity: element.opacity }
  .column.is-narrow.inspector-pane
    .box
      %h2.title.is-6 Element tree
      #element-tree
        - @elements.each do |element|
          %button.tree-item{ type: "button", data: { select_element: element.id } }
            %span= element.name.presence || element.type.demodulize
            %span.has-text-grey.is-size-7= "##{element.id}"
        - if @elements.empty?
          %p#tree-empty.has-text-grey.is-size-7 No elements yet.
    .box
      %h2.title.is-6 Properties
      %p#selection-empty.has-text-grey.is-size-7 Select an element to edit its properties.
      #inspector.is-hidden
        - { x: "X", y: "Y", width: "Width", height: "Height" }.each do |key, label|
          .field
            %label.label{ for: "element-#{key}" }= label
            .control= number_field_tag "element_#{key}", nil, class: "input is-small", id: "element-#{key}", step: "any", min: (key == "x" || key == "y" ? nil : 1)
        .field
          %label.label{ for: "element-fill" } Fill
          .control= color_field_tag :element_fill_color, "#48c78e", class: "input is-small canvas-color", id: "element-fill"
        %p.help The selected object can be mirrored or styled with FX from the tool pane.
        %p#point-help.help.is-hidden Drag the white handles on the canvas to move individual points.
        .buttons
          %button#delete-element.button.is-danger.is-light.is-small{ type: "button" } Delete
          %button#lock-element.button.is-light.is-small{ type: "button" } Lock
#editor-context-menu.context-menu.is-hidden{ role: "menu" }
:javascript
  (() => {
    const svg = document.getElementById("canvas-editor");
    if (!svg) return;
    const token = svg.dataset.csrf, menu = document.getElementById("editor-context-menu");
    const inspector = document.getElementById("inspector"), empty = document.getElementById("selection-empty");
    const pointHelp = document.getElementById("point-help");
    const fields = { x: document.getElementById("element-x"), y: document.getElementById("element-y"), width: document.getElementById("element-width"), height: document.getElementById("element-height"), fill_color: document.getElementById("element-fill") };
    let tool = "select", selectedIds = new Set(), drag = null, clipboard = null, history = [], historyIndex = -1;
    const idRemap = new Map();
    const shapes = () => [...svg.querySelectorAll(".canvas-shape")];
    const modelType = type => ({ rectangle: "Rectangle", ellipse: "Ellipse", polygon: "Polygon", line: "Line", bezier_line: "BezierLine", bezierline: "BezierLine", freeform_line: "FreeformLine", freeformline: "FreeformLine", cube: "Cube", sphere: "Sphere", cylinder: "Cylinder", mask: "Mask" }[type] || "Rectangle");
    const resolveId = id => idRemap.get(String(id)) || String(id);
    const byId = id => shapes().find(shape => shape.dataset.id === resolveId(id));
    const updateUrl = id => svg.dataset.updateUrl.replace("ELEMENT_ID", id);
    const parsePoints = shape => {
      try {
        const saved = JSON.parse(shape.dataset.points || "[]");
        return saved.map(item => Array.isArray(item) ? { x: Number(item[0]), y: Number(item[1]) } : { x: Number(String(item).split(",")[0]), y: Number(String(item).split(",")[1]) }).filter(p => Number.isFinite(p.x) && Number.isFinite(p.y));
      } catch (_) { return []; }
    };
    const pointStrings = shape => parsePoints(shape).map(p => `${p.x},${p.y}`);
    const refreshMasks = () => {
      svg.querySelector("#canvas-masks")?.remove();
      const defs = document.createElementNS("http://www.w3.org/2000/svg", "defs"); defs.id = "canvas-masks";
      const all = shapes(); all.forEach(shape => shape.removeAttribute("clip-path"));
      all.forEach((mask, maskIndex) => {
        if (mask.dataset.type !== "mask") return;
        const clip = document.createElementNS("http://www.w3.org/2000/svg", "clipPath"); clip.id = `clip-${mask.dataset.id}`; clip.setAttribute("clipPathUnits", "userSpaceOnUse");
        const region = document.createElementNS("http://www.w3.org/2000/svg", "rect"); region.setAttribute("x", mask.dataset.x); region.setAttribute("y", mask.dataset.y); region.setAttribute("width", mask.dataset.width); region.setAttribute("height", mask.dataset.height); clip.appendChild(region); defs.appendChild(clip);
        all.slice(0, maskIndex).filter(shape => shape.dataset.type !== "mask").forEach(shape => shape.setAttribute("clip-path", `url(#${clip.id})`));
      });
      svg.prepend(defs);
    };
    const render = source => {
      const x = Number(source.dataset.x), y = Number(source.dataset.y), w = Number(source.dataset.width), h = Number(source.dataset.height), type = source.dataset.type;
      const tag = type === "ellipse" || type === "sphere" ? "ellipse" : type === "polygon" || type === "cube" ? "polygon" : type === "line" || type === "freeformline" ? "polyline" : type === "bezierline" ? "path" : "rect";
      const shape = document.createElementNS("http://www.w3.org/2000/svg", tag);
      Object.assign(shape.dataset, { id: source.dataset.id, type, x, y, width: w, height: h, fill: source.dataset.fill || "#48c78e", stroke: source.dataset.stroke || "#257953", strokeWidth: source.dataset.strokeWidth || 2, opacity: source.dataset.opacity || 1, locked: source.dataset.locked || "false", points: source.dataset.points || "[]", name: source.dataset.name || "", options: source.dataset.options || "{}" });
      if (type === "ellipse" || type === "sphere") { shape.setAttribute("cx", x + w / 2); shape.setAttribute("cy", y + h / 2); shape.setAttribute("rx", w / 2); shape.setAttribute("ry", h / 2); }
      else if (["line", "freeformline", "polygon"].includes(type)) shape.setAttribute("points", pointStrings(shape).join(" "));
      else if (type === "cube") shape.setAttribute("points", `${x+w*.2},${y} ${x+w},${y} ${x+w},${y+h*.75} ${x+w*.8},${y+h} ${x},${y+h} ${x},${y+h*.25}`);
      else if (type === "bezierline") { const p = parsePoints(shape); if (p.length >= 4) shape.setAttribute("d", `M ${p[0].x} ${p[0].y} C ${p[1].x} ${p[1].y}, ${p[2].x} ${p[2].y}, ${p[3].x} ${p[3].y}`); }
      else { shape.setAttribute("x", x); shape.setAttribute("y", y); shape.setAttribute("width", w); shape.setAttribute("height", h); if (type === "cylinder") shape.setAttribute("rx", Math.min(w,h)*.14); }
      const options = JSON.parse(shape.dataset.options || "{}");
      shape.setAttribute("fill", ["line", "bezierline", "freeformline"].includes(type) ? "none" : shape.dataset.fill); shape.setAttribute("stroke", shape.dataset.stroke);
      shape.setAttribute("stroke-width", shape.dataset.strokeWidth); shape.setAttribute("opacity", shape.dataset.opacity); shape.classList.add("canvas-shape");
      shape.dataset.locked = source.dataset.locked || "false";
      if (type === "mask") { shape.setAttribute("fill", "#7aa7ff"); shape.setAttribute("fill-opacity", ".22"); shape.setAttribute("stroke-dasharray", "7 4"); }
      if (options.rotate || options.skew) shape.setAttribute("transform", `rotate(${Number(options.rotate || 0)} ${x + w / 2} ${y + h / 2}) skewX(${Number(options.skew || 0)})`);
      if (options.shadow) shape.style.filter = "drop-shadow(4px 5px 4px #3338)";
      return shape;
    };
    const serialized = shape => ({ id: shape.dataset.id, type: shape.dataset.type, x: Number(shape.dataset.x), y: Number(shape.dataset.y), width: Number(shape.dataset.width), height: Number(shape.dataset.height), fill_color: shape.dataset.fill, stroke_color: shape.dataset.stroke, stroke_width: Number(shape.dataset.strokeWidth), opacity: Number(shape.dataset.opacity), locked: shape.dataset.locked === "true", points: pointStrings(shape), options: JSON.parse(shape.dataset.options || "{}") });
    const refreshMirrors = () => {
      svg.querySelector("#fx-mirrors")?.remove(); refreshMasks();
      const group = document.createElementNS("http://www.w3.org/2000/svg", "g"); group.id = "fx-mirrors"; group.setAttribute("pointer-events", "none");
      shapes().forEach(shape => {
        const options = JSON.parse(shape.dataset.options || "{}"); if (!options.symmetry || options.symmetry === "none") return;
        const count = Math.max(2, Math.min(24, Number(options.count) || 2)), cx = Number(shape.dataset.x) + Number(shape.dataset.width) / 2, cy = Number(shape.dataset.y) + Number(shape.dataset.height) / 2;
        for (let i = 1; i < count; i++) { const clone = shape.cloneNode(true); clone.classList.remove("canvas-shape", "is-selected"); clone.removeAttribute("data-id");
          clone.setAttribute("transform", options.symmetry === "radial" ? `rotate(${360*i/count} ${cx} ${cy})` : `rotate(${180*i/count} ${cx} ${cy}) translate(${2*cx} 0) scale(-1 1)`); group.appendChild(clone); }
      });
      svg.appendChild(group);
    };
    const snapshot = () => JSON.stringify(shapes().map(serialized));
    const updateHistoryButtons = () => { document.getElementById("undo").disabled = historyIndex <= 0; document.getElementById("redo").disabled = historyIndex >= history.length - 1; };
    const recordHistory = () => { const state = snapshot(); if (history[historyIndex] === state) return; history = history.slice(0, historyIndex + 1); history.push(state); if (history.length > 50) history.shift(); historyIndex = history.length - 1; updateHistoryButtons(); };
    const drawPointHandles = () => {
      svg.querySelector(".point-handles")?.remove();
      const shape = selectedIds.size === 1 ? byId([...selectedIds][0]) : null;
      const supportsPoints = ["line", "freeformline", "bezierline", "polygon"].includes(shape?.dataset.type);
      pointHelp.classList.toggle("is-hidden", !supportsPoints);
      if (!shape || !supportsPoints) return;
      const group = document.createElementNS("http://www.w3.org/2000/svg", "g"); group.classList.add("point-handles");
      parsePoints(shape).forEach((p, index) => { const handle = document.createElementNS("http://www.w3.org/2000/svg", "circle"); handle.setAttribute("cx", p.x); handle.setAttribute("cy", p.y); handle.setAttribute("r", "7"); handle.dataset.pointIndex = index; handle.classList.add("point-handle"); group.appendChild(handle); });
      svg.appendChild(group);
    };
    const tree = document.getElementById("element-tree");
    const refreshTree = () => {
      const currentIds = new Set(shapes().map(shape => shape.dataset.id));
      tree.querySelectorAll("[data-select-element]").forEach(button => { if (!currentIds.has(resolveId(button.dataset.selectElement))) button.remove(); });
      shapes().forEach(shape => {
        if (tree.querySelector(`[data-select-element="${shape.dataset.id}"]`)) return;
        const button = document.createElement("button"); button.type = "button"; button.dataset.selectElement = shape.dataset.id; button.className = "tree-item";
        const label = document.createElement("span"); label.textContent = shape.dataset.name || `${shape.dataset.type[0].toUpperCase()}${shape.dataset.type.slice(1)}`;
        const id = document.createElement("span"); id.className = "has-text-grey is-size-7"; id.textContent = `#${shape.dataset.id}`;
        button.append(label, id); tree.appendChild(button);
      });
      tree.querySelectorAll("[data-select-element]").forEach(button => button.classList.toggle("is-active", selectedIds.has(resolveId(button.dataset.selectElement))));
      const treeEmpty = document.getElementById("tree-empty"); if (treeEmpty) treeEmpty.classList.toggle("is-hidden", currentIds.size > 0);
    };
    const select = ids => {
      selectedIds = new Set([...ids].map(resolveId));
      shapes().forEach(shape => shape.classList.toggle("is-selected", selectedIds.has(shape.dataset.id)));
      const shape = selectedIds.size === 1 ? byId([...selectedIds][0]) : null;
      inspector.classList.toggle("is-hidden", !shape); empty.classList.toggle("is-hidden", !!shape);
      if (shape) Object.entries(fields).forEach(([key, field]) => { field.value = key === "fill_color" ? shape.dataset.fill : shape.dataset[key]; });
      if (shape) document.getElementById("lock-element").textContent = shape.dataset.locked === "true" ? "Unlock" : "Lock";
      refreshTree(); drawPointHandles();
    };
    const api = async (url, method, data) => fetch(url, { method, headers: { "Content-Type": "application/json", "X-CSRF-Token": token, Accept: "application/json" }, ...(data ? { body: JSON.stringify({ element: data }) } : {}) });
    const save = async (shape, attrs, record = true) => {
      Object.entries(attrs).forEach(([key, value]) => { shape.dataset[key === "fill_color" ? "fill" : key === "stroke_color" ? "stroke" : key === "stroke_width" ? "strokeWidth" : key] = Array.isArray(value) ? JSON.stringify(value) : value; });
      const response = await api(updateUrl(shape.dataset.id), "PATCH", attrs); if (!response.ok) return;
      const fresh = render(shape); shape.replaceWith(fresh); refreshMirrors(); select(selectedIds); if (record) recordHistory();
    };
    const createElement = async (data, historyChange = true) => {
      const response = await api(svg.dataset.createUrl, "POST", data); if (!response.ok) return null;
      const saved = await response.json(), source = document.createElementNS("http://www.w3.org/2000/svg", "g");
      Object.assign(source.dataset, { id: saved.id, type: saved.type.split("::").pop().toLowerCase(), x: saved.x, y: saved.y, width: saved.width, height: saved.height, fill: saved.fill_color, stroke: saved.stroke_color, strokeWidth: saved.stroke_width, opacity: saved.opacity, locked: saved.locked, points: JSON.stringify(saved.points || data.points || []), name: saved.name || data.name || "", options: JSON.stringify(saved.options || data.options || {}) });
      const shape = render(source); svg.querySelector("#fx-mirrors")?.remove(); svg.appendChild(shape); refreshMirrors(); select([shape.dataset.id]); if (historyChange) recordHistory(); return shape;
    };
    const deleteShape = async shape => { await api(updateUrl(shape.dataset.id), "DELETE"); shape.remove(); selectedIds.delete(shape.dataset.id); refreshMirrors(); };
    const restoreSnapshot = async state => {
      const target = JSON.parse(state), targetIds = new Set(target.map(item => resolveId(item.id)));
      for (const shape of shapes()) if (!targetIds.has(shape.dataset.id)) await deleteShape(shape);
      for (const item of target) {
        let shape = byId(item.id);
        const attrs = { x: item.x, y: item.y, width: item.width, height: item.height, fill_color: item.fill_color, stroke_color: item.stroke_color, stroke_width: item.stroke_width, opacity: item.opacity, locked: item.locked, points: item.points, options: item.options };
        if (!shape) {
          const created = await createElement({ ...attrs, type: `ShareSpace::${item.type[0].toUpperCase()}${item.type.slice(1)}`, visible: true }, false);
          if (created && String(item.id) !== created.dataset.id) idRemap.set(String(item.id), created.dataset.id);
        } else await save(shape, attrs, false);
      }
      select([]); drawPointHandles();
    };
    const undo = async () => { if (historyIndex <= 0) return; historyIndex -= 1; await restoreSnapshot(history[historyIndex]); updateHistoryButtons(); };
    const redo = async () => { if (historyIndex >= history.length - 1) return; historyIndex += 1; await restoreSnapshot(history[historyIndex]); updateHistoryButtons(); };
    const showMenu = (event, element) => {
      event.preventDefault();
      if (element) select([element.dataset.id]);
      const actions = element ? [["copy", "Copy"], ["paste", "Paste"], ["delete", "Delete"], ["lock", element.dataset.locked === "true" ? "Unlock" : "Lock"]] : [["select-all", "Select all"], ["undo", "Undo"], ["redo", "Redo"], ["paste", "Paste"]];
      menu.replaceChildren(...actions.map(([action, label]) => { const button = document.createElement("button"); button.type = "button"; button.dataset.action = action; button.textContent = label; button.disabled = (action === "undo" && historyIndex <= 0) || (action === "redo" && historyIndex >= history.length - 1) || (action === "paste" && !clipboard); return button; }));
      menu.style.left = `${event.clientX}px`; menu.style.top = `${event.clientY}px`; menu.classList.remove("is-hidden");
    };
    const paste = async () => { if (!clipboard) return; const data = { ...clipboard, type: `ShareSpace::${modelType(clipboard.type)}`, x: Number(clipboard.x) + 20, y: Number(clipboard.y) + 20, points: clipboard.points.map(value => { const [x,y] = value.split(",").map(Number); return `${x+20},${y+20}`; }) }; delete data.id; delete data.locked; await createElement(data); };
    shapes().forEach(shape => shape.replaceWith(render(shape))); refreshMirrors();
    history = [snapshot()]; historyIndex = 0; updateHistoryButtons();
    svg.addEventListener("pointerdown", event => {
      const handle = event.target.closest(".point-handle");
      if (handle) { const shape = byId([...selectedIds][0]), points = parsePoints(shape), p = localPoint(event); drag = { kind: "point", shape, index: Number(handle.dataset.pointIndex), points }; svg.setPointerCapture(event.pointerId); event.preventDefault(); return; }
      const el = event.target.closest(".canvas-shape"); if (tool !== "select") return;
      if (!el) { select([]); return; }
      select([el.dataset.id]); if (el.dataset.locked === "true") return;
      const p = localPoint(event); drag = { kind: "element", el, x: p.x, y: p.y, startX: Number(el.dataset.x), startY: Number(el.dataset.y), points: parsePoints(el) }; svg.setPointerCapture(event.pointerId);
    });
    svg.addEventListener("pointermove", event => {
      if (!drag) return; const p = localPoint(event);
      if (drag.kind === "draw") { const last = drag.points[drag.points.length - 1]; if (Math.hypot(p.x-last.x, p.y-last.y) > 3) drag.points.push(p); drag.preview.dataset.points = JSON.stringify(drag.points.map(point => `${point.x},${point.y}`)); const fresh = render(drag.preview); drag.preview.replaceWith(fresh); drag.preview = fresh; }
